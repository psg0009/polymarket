# --- Polymarket / on-chain ---
# Polygon mainnet EOA private key (no 0x prefix required, but tolerated)
PRIVATE_KEY=
# Funder address; for proxy wallets this differs from EOA address
FUNDER=
# 1=EOA, 2=Polymarket proxy, 3=Email/magic proxy. See py-clob-client docs.
SIGNATURE_TYPE=1
# CLOB host
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
CHAIN_ID=137

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Hard daily ceiling on Anthropic spend, USD. Once today's running spend
# exceeds this, the oracle refuses every new API call until the next UTC
# midnight. Set to 0 to disable (not recommended).
ANTHROPIC_DAILY_USD_BUDGET=50

# --- Risk caps (USD) ---
MAX_NOTIONAL_PER_TRADE=25
MAX_NOTIONAL_PER_DAY=100
KELLY_FRACTION=0.25
MIN_EDGE_BPS=300                   # 3 cents
MIN_BOOK_DEPTH_USD=50
MIN_AMBIGUITY_CLARITY=0.7

# --- Mode flags ---
DRY_RUN=true
ALLOW_AGGRESSIVE=false             # FOK / market orders
INDIA_ONLY=false

# --- Storage ---
DATABASE_URL=sqlite:///./data/polyclaude.sqlite
LOG_LEVEL=INFO

# --- Optional news ingestion ---
NEWSAPI_KEY=
RSS_FEEDS=https://feeds.reuters.com/reuters/topNews,https://feeds.bbci.co.uk/news/world/rss.xml
INDIA_RSS_FEEDS=https://www.thehindu.com/feeder/default.rss,https://indianexpress.com/feed/
