# Copy to .streamlit/secrets.toml — never commit it.
#
# Streamlit Community Cloud also lets you paste this content into
# https://share.streamlit.io → app → Settings → Secrets, in which case the
# local file is unnecessary.

# Hosted SQLite via Turso. Get this URL from `turso db show <name> --url`
# and the auth token from `turso db tokens create <name>`.
DATABASE_URL = "sqlite+libsql://<your-db-name>-<your-org>.turso.io/?authToken=<TOKEN>"

# Optional: only needed if you want the dashboard to call Anthropic directly.
# The agent (running locally / in a worker) is what writes oracle calls to the
# ledger; the dashboard is read-only by design.
# ANTHROPIC_API_KEY = "sk-ant-..."
